<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Used only to check the currently connected WiFi network's SSID and the connection state
        of paired Bluetooth devices, for Context Profiles' WiFi/Bluetooth triggers. Opt-in per
        profile; never used for anything else.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

</manifest>
