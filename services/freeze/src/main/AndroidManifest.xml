<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Special access, granted manually via Settings > Usage access (not a runtime dialog).
        Used only to check whether a freeze candidate is currently the foreground app, so we
        never freeze it out from under the user. See PermissionGroup.UsageAccess.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Optional Island (com.oasisfeng.island) freeze backend. Harmless if Island isn't installed. -->
    <uses-permission android:name="com.oasisfeng.island.permission.FREEZE_PACKAGE" />

    <!-- So we can resolve/launch the Island app for its freeze intents on Android 11+. -->
    <queries>
        <package android:name="com.oasisfeng.island" />
    </queries>

    <application>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            Optional Device Owner freeze backend (see DeviceOwnerProvider). Registering this
            receiver only makes the app a plain device admin, which grants none of the app-suspend
            capabilities by itself - those additionally require device owner status, established
            out-of-band via `adb shell dpm set-device-owner` (see the guided setup screen).
        -->
        <receiver
            android:name=".providers.DeviceOwnerAdminReceiver"
            android:label="@string/freeze_backend_device_owner"
            android:description="@string/freeze_device_owner_admin_description"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_owner_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
