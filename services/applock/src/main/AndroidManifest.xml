<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Special access, granted manually via Settings > Usage access (not a runtime dialog).
        Used only for the UsageStatsManager half of App Lock's hybrid foreground-app detection -
        see AppLockForegroundMonitor. Already declared by :services:freeze too; redeclared here
        so this module documents its own requirements independently of that one.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Runtime-requested, opt-in. Used only for the intruder photo feature (IntruderPhotoManager)
        to take a single front-camera photo on a failed App Lock authentication attempt. Not
        required=true, since the launcher must work fully without a camera - the feature is
        simply unavailable (its settings toggle stays gated behind the permission).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

</manifest>
