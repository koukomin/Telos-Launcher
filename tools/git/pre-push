#!/usr/bin/env bash
set -euo pipefail

declare -A checked=()
while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_ref" == "(delete)" ]]; then continue; fi
    commit=$(git rev-parse --verify "$local_oid^{commit}")
    if [[ ${checked[$commit]+yes} ]]; then continue; fi
    bash tools/git/validate-candidate.sh "$commit" "$remote_oid"
    checked[$commit]=1
done
