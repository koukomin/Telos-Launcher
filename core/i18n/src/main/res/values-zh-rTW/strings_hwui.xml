<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="hc_graphics_api">圖形 API</string>
    <string name="hc_graphics_api_about">作用說明</string>
    <string name="hc_graphics_api_about_summary">將 Android 介面算繪器（HWUI / Skia）強制為 Vulkan 或 OpenGL ES，與 GAMA 使用的 debug.hwui.renderer 開關相同。Vulkan 通常較省電、較涼爽；若 Vulkan 出問題，可用 OpenGL。應用程式與遊戲仍可自選 API。重新開機會清除該屬性，除非開啟開機還原且有 Shizuku 或 root。若畫面卡住，長按音量減與電源鍵。</string>
    <string name="hc_graphics_renderer">算繪器</string>
    <string name="hc_graphics_renderer_summary">需要 Shizuku、root 或 ADB（複製下方指令）</string>
    <string name="hc_graphics_default">系統預設</string>
    <string name="hc_graphics_vulkan">Vulkan</string>
    <string name="hc_graphics_opengl">OpenGL</string>
    <string name="hc_graphics_current">目前算繪器</string>
    <string name="hc_graphics_unknown">未知</string>
    <string name="hc_graphics_priv_ok">Shizuku 或 root 已就緒</string>
    <string name="hc_graphics_priv_missing">沒有 Shizuku 或 root — 請使用 ADB</string>
    <string name="hc_graphics_restore_boot">重新開機後還原</string>
    <string name="hc_graphics_restore_boot_summary">在有 Shizuku 或 root 時於開機後重新套用 Vulkan 或 OpenGL。Android 重新開機時總會清除該屬性。</string>
    <string name="hc_graphics_copy_adb">複製 ADB 指令</string>
    <string name="hc_graphics_adb_copied">已複製 ADB 指令</string>
    <string name="hc_graphics_applied">已套用算繪器。部分畫面可能需要重新開機。</string>
    <string name="hc_graphics_need_privilege">無法套用。請授予 Shizuku、使用 root，或執行：\n%1$s</string>
    <string name="hc_graphics_widget_switch">從系統小工具切換</string>
    <string name="hc_graphics_widget_switch_summary">允許主畫面上的系統小工具切換 Vulkan 或 OpenGL。預設關閉。需要 Shizuku、root 或 ADB。</string>
    <string name="hc_graphics_widget_locked">請先在設定 → 進階 → 圖形 API 開啟「從系統小工具切換」</string>
    <string name="hc_system_widget_enable">主畫面系統小工具</string>
    <string name="hc_system_widget_enable_summary">預設關閉。開啟後，可從小工具選擇器新增系統小工具（Vulkan、記憶體、網路）。</string>
</resources>
