    <string name="telos_shizuku_pair_found">পেয়ারিং পরিষেবা %1$s:%2$d। ৬ অঙ্কের কোড লিখুন বা ডায়ালগ খোলা রাখুন।</string>
    <string name="telos_shizuku_pair_waiting">পেয়ারিং কোডের অপেক্ষা। ডেভেলপার অপশন → ওয়্যারলেস ডিবাগিং → কোড দিয়ে পেয়ার, অথবা এখানে ৬ অঙ্ক লিখুন।</string>
