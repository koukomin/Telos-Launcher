    <string name="web_app_presets_title">প্রস্তাবিত বিভাগ</string>
    <string name="web_app_presets_summary">জনপ্রিয় ওয়েবসাইট নিয়ে তৈরি একটি ফোল্ডার ওয়েব অ্যাপ হিসেবে যোগ করুন। আপনি বেছে না নেওয়া পর্যন্ত কিছুই যোগ হয় না, এবং প্রতিটি ফোল্ডার ও ওয়েব অ্যাপ পরে সম্পাদনা বা মুছে ফেলা যায়।</string>
    <string name="web_app_presets_login_note">প্রতিটি ওয়েবসাইটে আলাদাভাবে সাইন ইন করুন। লগইন তথ্য এমবেডেড ব্রাউজারে সংরক্ষিত থাকে। এটি শুধু এমবেডেড ব্রাউজারে খোলা ওয়েব অ্যাপের ক্ষেত্রে প্রযোজ্য; বাহ্যিক ব্রাউজারে খোলা ওয়েব অ্যাপ সেই ব্রাউজারের নিজস্ব সাইন-ইন ব্যবহার করে।</string>
