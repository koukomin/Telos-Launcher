<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="desktop_vault_restore_title">전체 vault 복원</string>
    <string name="desktop_vault_restore_hint">AES 세션 백업에서 desktop.properties와 ~/.config/telos를 복원합니다. WireGuard 개인 키는 로그에 기록되지 않습니다. 확인이 필요합니다.</string>
    <string name="desktop_vault_restore_preview_btn">복원 미리보기</string>
    <string name="desktop_vault_restore_preview">Telos 구성 파일 %1$s개를 복원할 준비가 되었습니다(desktop.properties: %2$s). 적용하려면 확인하세요.</string>
    <string name="desktop_vault_restore_confirm">복원 확인</string>
    <string name="desktop_vault_restore_cancel">복원 취소</string>
    <string name="desktop_vault_restore_done">Vault 세션 구성이 복원되었습니다</string>
    <string name="desktop_vault_restore_need_confirm">복원 확인이 필요합니다</string>
    <string name="desktop_luks_restore_title">LUKS vault 이미지 복원</string>
    <string name="desktop_luks_restore_hint">telos_vault.img 백업을 portable/vault 이미지 경로로 복사합니다. vault는 잠겨 있어야 합니다. 비밀번호로 절대 마운트하지 않습니다 — 복원 후 별도로 잠금 해제하세요. 확인 및 SHA-256 검사가 필요합니다.</string>
    <string name="desktop_luks_restore_path_label">백업 이미지 경로 (telos_vault.img)</string>
    <string name="desktop_luks_restore_preview_btn">LUKS 이미지 복원 미리보기</string>
    <string name="desktop_luks_restore_preview">%1$s바이트 복원 준비됨(sha256 %2$s…). 복사하려면 확인하세요. vault는 잠긴 상태를 유지해야 합니다.</string>
    <string name="desktop_luks_restore_confirm">LUKS 이미지 복원 확인</string>
    <string name="desktop_luks_restore_cancel">LUKS 복원 취소</string>
    <string name="desktop_luks_restore_done">LUKS 이미지가 %1$s(으)로 복원됨(여전히 잠김 — 별도 잠금 해제)</string>
    <string name="desktop_luks_restore_need_confirm">LUKS 이미지 복원 확인이 필요합니다</string>
    <string name="desktop_luks_restore_locked_required">LUKS 이미지를 복원하기 전에 vault가 잠겨 있어야 합니다</string>
    <string name="desktop_update_title">서명된 데스크톱 업데이트</string>
    <string name="desktop_update_hint">Telos Ed25519 키로 서명된 로컬 file:// 경로 또는 HTTPS 매니페스트를 확인합니다. 업데이트는 portable/vault 임시 영역에 스테이징되며 자동 설치되지 않습니다. 기본 채널: GitHub Releases 자산 telos-desktop-update.manifest.</string>
    <string name="desktop_update_releases_hint">GitHub Releases 기본값: %1$s</string>
    <string name="desktop_update_use_releases">GitHub Releases URL 사용</string>
    <string name="desktop_update_releases_filled">GitHub Releases 매니페스트 URL이 채워짐</string>
    <string name="desktop_update_url_label">업데이트 매니페스트(경로, file:// 또는 https://)</string>
    <string name="desktop_update_save_url">업데이트 URL 저장</string>
    <string name="desktop_update_url_saved">업데이트 매니페스트 URL이 저장되었습니다</string>
    <string name="desktop_update_check">서명된 업데이트 확인</string>
    <string name="desktop_update_ready">서명된 업데이트 %1$s 검증됨 — 준비 설치를 확인하세요</string>
    <string name="desktop_update_install_confirm">준비 설치 확인</string>
    <string name="desktop_update_install_cancel">업데이트 취소</string>
    <string name="desktop_update_installed">업데이트가 %1$s(으)로 스테이징됨 — 재시작 도우미 확인(실행 중 jar 교체는 최선의 노력)</string>
    <string name="desktop_update_sig_fail">업데이트 서명 검증 실패</string>
    <string name="desktop_update_no_url">먼저 file:// 또는 HTTPS 업데이트 매니페스트 URL을 설정하세요</string>
    <string name="desktop_update_restart_hint">재시작 도우미는 보류 업데이트 마커와 선택적 교체 스크립트를 쓴 뒤 종료합니다. 실행 중인 JVM jar 교체는 최선의 노력입니다.</string>
    <string name="desktop_update_restart_confirm">업데이트 후 재시작 확인</string>
    <string name="desktop_update_restart_later">나중에 재시작</string>
    <string name="desktop_update_restart_failed">업데이트 재시작 도우미를 준비할 수 없음</string>
</resources>
