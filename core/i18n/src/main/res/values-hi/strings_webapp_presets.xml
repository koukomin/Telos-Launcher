<resources>
    <string name="web_app_presets_title">सुझाई गई श्रेणियाँ</string>
    <string name="web_app_presets_summary">लोकप्रिय वेबसाइटों वाला तैयार फ़ोल्डर वेब ऐप्स के रूप में जोड़ें। जब तक आप चुनते नहीं, कुछ भी नहीं जुड़ता, और हर फ़ोल्डर और वेब ऐप को बाद में बदला या हटाया जा सकता है।</string>
    <string name="web_app_presets_login_note">हर वेबसाइट पर अलग से साइन इन करें। लॉगिन एम्बेडेड ब्राउज़र में सहेजे जाते हैं। यह केवल उन वेब ऐप्स पर लागू होता है जो एम्बेडेड ब्राउज़र में खुलते हैं; बाहरी ब्राउज़र में खुलने वाले वेब ऐप्स उस ब्राउज़र के अपने साइन-इन का उपयोग करते हैं।</string>
