    <string name="telos_shizuku_pair_title">Kodiċi ta’ tqabbil</string>
    <string name="telos_shizuku_pair_searching">Qed infittex is-servizz ta’ tqabbil… Ħalli d-djalogu tas-Settings miftuħ.</string>
    <string name="telos_shizuku_pair_found">Servizz ta’ tqabbil f’%1$s:%2$d. Daħħal il-kodiċi ta’ 6 ċifri jew ħalli d-djalogu miftuħ.</string>
    <string name="telos_shizuku_pair_waiting">Nistennew il-kodiċi. Iftaħ Għażliet tal-iżviluppatur → Debugging wireless → Qabbel b’kodiċi, jew ittajpja s-6 ċifri hawn.</string>
    <string name="telos_shizuku_pair_code">Kodiċi ta’ 6 ċifri</string>
    <string name="telos_shizuku_pair_submit">Qabbel</string>
    <string name="telos_shizuku_pair_working">Qed nqabbel…</string>
