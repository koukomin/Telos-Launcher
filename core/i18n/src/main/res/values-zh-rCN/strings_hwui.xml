<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="hc_graphics_api">图形 API</string>
    <string name="hc_graphics_api_about">作用说明</string>
    <string name="hc_graphics_api_about_summary">将 Android 界面渲染器（HWUI / Skia）强制为 Vulkan 或 OpenGL ES，与 GAMA 使用的 debug.hwui.renderer 开关相同。Vulkan 通常更省电、更凉爽；若 Vulkan 出问题，可用 OpenGL。应用和游戏仍可自选 API。重启会清除该属性，除非开启开机恢复且有 Shizuku 或 root。若屏幕卡住，长按音量减和电源键。</string>
    <string name="hc_graphics_renderer">渲染器</string>
    <string name="hc_graphics_renderer_summary">需要 Shizuku、root 或 ADB（复制下方命令）</string>
    <string name="hc_graphics_default">系统默认</string>
    <string name="hc_graphics_vulkan">Vulkan</string>
    <string name="hc_graphics_opengl">OpenGL</string>
    <string name="hc_graphics_current">当前渲染器</string>
    <string name="hc_graphics_unknown">未知</string>
    <string name="hc_graphics_priv_ok">Shizuku 或 root 已就绪</string>
    <string name="hc_graphics_priv_missing">没有 Shizuku 或 root — 请使用 ADB</string>
    <string name="hc_graphics_restore_boot">重启后恢复</string>
    <string name="hc_graphics_restore_boot_summary">在有 Shizuku 或 root 时于开机后重新应用 Vulkan 或 OpenGL。Android 重启时总会清除该属性。</string>
    <string name="hc_graphics_copy_adb">复制 ADB 命令</string>
    <string name="hc_graphics_adb_copied">已复制 ADB 命令</string>
    <string name="hc_graphics_applied">已应用渲染器。部分界面可能需要重启。</string>
    <string name="hc_graphics_need_privilege">无法应用。请授予 Shizuku、使用 root，或运行：\n%1$s</string>
    <string name="hc_graphics_widget_switch">从系统小组件切换</string>
    <string name="hc_graphics_widget_switch_summary">允许主屏幕上的系统小组件切换 Vulkan 或 OpenGL。默认关闭。需要 Shizuku、root 或 ADB。</string>
    <string name="hc_graphics_widget_locked">请先在设置 → 高级 → 图形 API 中打开“从系统小组件切换”</string>
    <string name="hc_system_widget_enable">主屏幕系统小组件</string>
    <string name="hc_system_widget_enable_summary">默认关闭。打开后，可从小组件选择器添加系统小组件（Vulkan、内存、网络）。</string>
</resources>
