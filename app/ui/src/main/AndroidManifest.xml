<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
        Used only to detect an active/ringing call for the Dynamic Island pill. Opt-in
        (Dynamic Island setting), off by default; never used for anything else.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Used for Web App Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="com.kieronquinn.app.smartspacer.permission.ACCESS_SMARTSPACER"/>
    <uses-sdk tools:overrideLibrary="com.kieronquinn.app.smartspacer.sdk,com.kieronquinn.app.smartspacer.sdk.client" />

    <application>

        <activity
            android:name=".launcher.LauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:theme="@style/LauncherTheme"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <activity
            android:name=".assistant.AssistantActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="de.mm20.launcher2.assistant"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:theme="@style/AssistantTheme"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".comms.CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.incall"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:turnScreenOn="true" />

        <activity
            android:name=".comms.SipCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.sipcall"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:turnScreenOn="true" />

        <activity
            android:name=".comms.MissedCallPopupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.missedpopup"
            android:theme="@style/Theme.AppCompat.DayNight.Dialog" />

        <service
            android:name=".comms.FloatingNotesService"
            android:exported="false" />

        <receiver
            android:name=".comms.RecentsWidgetProvider"
            android:exported="true"
            android:label="Recent calls">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recents_widget_info" />
        </receiver>
        <receiver
            android:name=".comms.DirectCallWidgetProvider"
            android:exported="true"
            android:label="Dialpad">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/direct_call_widget_info" />
        </receiver>
        <activity
            android:name=".screenshot.ScreenshotEditorActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <receiver
            android:name=".screenshot.ScreenshotActionReceiver"
            android:exported="false" />
        <service
            android:name=".screenrec.ScreenRecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <activity
            android:name=".screenrec.ScreenRecorderRequestActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".voice.VoiceRecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".calculator.CalculatorTileService"
            android:exported="true"
            android:icon="@drawable/ic_glyph_calculator"
            android:label="@string/hc_calculator"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".comms.NetworkTileService"
            android:exported="true"
            android:icon="@drawable/signal_cellular_alt_24px"
            android:label="Cellular"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name=".comms.FakeCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.fakecall"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:turnScreenOn="true" />

        <activity
            android:name=".comms.DialerHandleActivity"
            android:exported="true"
            android:icon="@drawable/ic_app_phone_full"
            android:label="Telos Phone"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.settings"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:enableOnBackInvokedCallback="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value="de.mm20.launcher2.ui.launcher.LauncherActivity" />

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"/>
                <data android:path="/in-app"/>
                <data android:path="/in-app.html"/>
                <data android:host="kvaesitso.mm20.de"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".store.StoreLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="obtainium" />
            </intent-filter>
        </activity>

        <!-- Telos Viewer as a document viewer: PDF, text, Office and OpenDocument files -->
        <activity
            android:name=".media.docs.DocumentViewerActivity"
            android:exported="true"
            android:icon="@drawable/ic_app_viewer_full"
            android:label="Telos Viewer"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.google-apps.document" />
                <data android:mimeType="application/vnd.google-apps.spreadsheet" />
                <data android:mimeType="application/vnd.google-apps.presentation" />
                <data android:mimeType="application/vnd.google-apps.drawing" />
                <data android:mimeType="application/vnd.google-apps.form" />
            </intent-filter>
        </activity>

        <!-- Telos PDF tools (adapted from PaperKnife+), started from the Telos Viewer document viewer -->
        <activity
            android:name=".media.docs.pdf.PdfToolsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:icon="@drawable/ic_app_photos_full"
            android:label="@string/pdft_title"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <!-- Telos Messages: what the system and other apps open for text links and shared files -->
        <activity
            android:name=".comms.ComposeSmsActivity"
            android:exported="true"
            android:icon="@drawable/ic_app_messages_full"
            android:label="Telos Messages"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Telos Downloads: share a link to it, or open a link to a file with it. Magnet links and .torrent files are offered here and in Telos Video (Video streams while it downloads, Downloads keeps and seeds). -->
        <activity
            android:name=".downloads.DownloadShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@drawable/ic_app_downloads_full"
            android:label="Telos Downloads"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- only links that name a kind of file, so that Telos is not offered for every web page -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-iso9660-image" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
        </activity>

        <activity
            android:name=".media.photos.PhotoViewerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:icon="@drawable/ic_app_photos_full"
            android:label="Telos Photos"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".media.photos.PhotoEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <!-- Adds a shared radio station after the user confirms: telos-radio://add, shared text, stream/playlist links -->
        <activity
            android:name=".comms.radio.RadioAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.TelosRadioAdd">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="telos-radio" android:host="add" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="icy" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="audio/x-scpls" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/aac" />
                <data android:mimeType="audio/aacp" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.m3u" />
                <data android:pathPattern=".*\\.pls" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.aac" />
            </intent-filter>
        </activity>

        <!-- Redirect of the Trakt sign in in the browser; the state is verified before anything is stored -->
        <activity
            android:name=".media.video.TraktCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="telos-trakt" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- Redirect of the Last.fm sign in in the browser; only accepted while a sign in was started in the app -->
        <activity
            android:name=".media.music.LastFmCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="telos-lastfm" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- The same player in its own process, see IsolatedVideoPlayerActivity -->
        <activity
            android:name=".media.video.IsolatedVideoPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="false"
            android:process=":player"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />

        <service
            android:name=".media.video.VideoPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <service
            android:name=".media.video.IsolatedVideoPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:process=":player">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <activity
            android:name=".media.video.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:icon="@drawable/ic_app_video_full"
            android:label="Telos Video"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <!-- links to a video or a .torrent file on the web, and links or torrent files shared to Telos Video -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".launcher.sheets.BindAndConfigureAppWidgetActivity" />

        <!--
            App Lock's gate screen. Its own task (no affinity, excluded from recents) so it sits
            on top of whatever locked app triggered it without merging into that app's own task -
            finishing it after a successful unlock reveals that app directly.
        -->
        <activity
            android:name=".applock.AppLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/LauncherTheme"
            android:enableOnBackInvokedCallback="true" />

        <!--
            App Lock's gate for a locked web app shortcut - reached from WebAppShortcutImpl.launch()
            (see WebAppLockLaunchContract) directly from the user's own tap, same task shape as
            WebAppActivity itself since there's no overlay/background-launch case to isolate from.
        -->
        <activity
            android:name=".applock.WebAppLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/LauncherTheme"
            android:enableOnBackInvokedCallback="true" />

        <activity
            android:name=".desktopmode.DesktopModeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/LauncherTheme" />

        <service
            android:name=".floating.FloatingLauncherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent floating quick-launcher overlay, opt-in and off by default" />
        </service>

        <!--
            Failsafe kill-switch for the floating launcher overlay - see
            FloatingLauncherDisableReceiver's doc. Exported so it's reachable via adb even if the
            overlay itself has made the device unresponsive to touch; it can only ever turn the
            (opt-in, off-by-default) overlay off, never on or do anything else, so this is a
            deliberately narrow, low-risk surface to expose.
        -->
        <receiver
            android:name=".floating.FloatingLauncherDisableReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="de.mm20.launcher2.action.DISABLE_FLOATING_LAUNCHER" />
            </intent-filter>
        </receiver>

        <service
            android:name=".islandoverlay.DynamicIslandService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent Dynamic Island pill overlay, opt-in and off by default" />
        </service>

        <service
            android:name=".applock.AppLockOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches for locked apps coming to the foreground and shows a blocking overlay, opt-in and off by default" />
        </service>

        <activity
            android:name=".launcher.ImportThemeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/DialogTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.de.mm20.launcher2.theme" />
            </intent-filter>
        </activity>

        <activity
            android:name=".webapp.WebAppActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/LauncherTheme" />
    </application>

</manifest>