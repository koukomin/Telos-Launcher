<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device transfer. Keeps secrets, tokens and private recordings out. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="telos_vault_prefs.xml" />
        <exclude domain="sharedpref" path="nextcloud.xml" />
        <exclude domain="sharedpref" path="owncloud.xml" />
        <exclude domain="sharedpref" path="trakt.xml" />
        <exclude domain="sharedpref" path="scrobble.xml" />
        <exclude domain="sharedpref" path="telos_notes_sync.xml" />
        <exclude domain="sharedpref" path="telos_torrent_session.xml" />
        <exclude domain="sharedpref" path="telos_downloads_media.xml" />
        <exclude domain="file" path="sip" />
        <exclude domain="file" path="CallRecordings" />
        <exclude domain="file" path="VoiceRecordings" />
        <exclude domain="file" path="intruder_photos" />
        <exclude domain="file" path="downloads" />
        <exclude domain="file" path="album_art" />
        <exclude domain="file" path="blocklists" />
        <exclude domain="file" path="remote_phonebook.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="telos_vault_prefs.xml" />
        <exclude domain="sharedpref" path="nextcloud.xml" />
        <exclude domain="sharedpref" path="owncloud.xml" />
        <exclude domain="sharedpref" path="trakt.xml" />
        <exclude domain="sharedpref" path="scrobble.xml" />
        <exclude domain="sharedpref" path="telos_notes_sync.xml" />
        <exclude domain="file" path="sip" />
        <exclude domain="file" path="downloads" />
    </device-transfer>
</data-extraction-rules>
