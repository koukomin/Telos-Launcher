<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Needed to enumerate installed browsers for the web app shortcut renderer picker
        (CustomTabsBrowsers) - without this, queryIntentActivities silently returns nothing on
        API 30+ due to package visibility.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
