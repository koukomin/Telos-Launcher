#!/bin/sh
export TELOS_SESSION=1
export TELOS_SESSION_HOME=full
export TELOS_VAULT_UNLOCKED="${TELOS_VAULT_UNLOCKED:-1}"
CONF_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
if [ -x "$CONF_DIR/telos-notifyd" ]; then
  "$CONF_DIR/telos-notifyd" &
fi
if [ -x "$CONF_DIR/telos-layer" ]; then
  "$CONF_DIR/telos-layer" &
fi
start_portal() {
  for cand in "$@"; do
    if [ -x "$cand" ]; then
      "$cand" &
      return 0
    fi
  done
  if command -v "$1" >/dev/null 2>&1; then
    "$1" &
  fi
}
start_portal /usr/libexec/xdg-desktop-portal /usr/lib/xdg-desktop-portal xdg-desktop-portal
start_portal /usr/libexec/xdg-desktop-portal-wlr /usr/lib/xdg-desktop-portal-wlr xdg-desktop-portal-wlr
start_portal /usr/libexec/xdg-desktop-portal-gtk /usr/lib/xdg-desktop-portal-gtk xdg-desktop-portal-gtk
if [ -z "${TELOS_JAR:-}" ] || [ ! -f "$TELOS_JAR" ]; then
  echo "telos autostart: TELOS_JAR missing" >&2
  exit 1
fi
exec java -Xms256m -Xmx2048m -XX:+UseG1GC -jar "$TELOS_JAR" --session --already-unlocked
