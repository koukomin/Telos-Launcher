<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>10</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
    <decoration>client</decoration>
  </core>
  <margin>
    <top>36</top>
    <bottom>56</bottom>
    <left>0</left>
    <right>0</right>
  </margin>
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <theme>
    <name>Telos</name>
    <cornerRadius>10</cornerRadius>
  </theme>
  <windowRules>
    <windowRule identifier="Telos Desktop">
      <skipTaskbar>yes</skipTaskbar>
      <skipPager>yes</skipPager>
      <serverDecoration>no</serverDecoration>
      <iconify>no</iconify>
      <fullscreen>yes</fullscreen>
    </windowRule>
    <windowRule identifier="MainKt">
      <skipTaskbar>yes</skipTaskbar>
      <skipPager>yes</skipPager>
      <serverDecoration>no</serverDecoration>
      <iconify>no</iconify>
      <fullscreen>yes</fullscreen>
    </windowRule>
    <windowRule title="Telos Desktop">
      <skipTaskbar>yes</skipTaskbar>
      <skipPager>yes</skipPager>
      <serverDecoration>no</serverDecoration>
      <iconify>no</iconify>
      <fullscreen>yes</fullscreen>
    </windowRule>
  </windowRules>
  <keyboard>
    <default />
    <keybind key="W-Return">
      <action name="Execute" command="sh -c '${TERMINAL:-} || foot || kitty || gnome-terminal || xterm'" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-Escape">
      <action name="Exit" />
    </keybind>
  </keyboard>
</labwc_config>
