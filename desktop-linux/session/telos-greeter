#!/usr/bin/env python3
"""W3: GTK vault password dialog. Pipes stdin to java --unlock-stdin."""
import os
import subprocess
import sys

JAR = os.environ.get("TELOS_JAR", "")


def console_fallback():
    os.execvp("java", ["java", "-jar", JAR, "--unlock-only"])


def main():
    if not JAR or not os.path.isfile(JAR):
        sys.stderr.write("telos-greeter: TELOS_JAR missing\n")
        sys.exit(1)
    if not os.environ.get("WAYLAND_DISPLAY") and not os.environ.get("DISPLAY"):
        console_fallback()
        return
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
    except Exception:
        console_fallback()
        return

    win = Gtk.Window(title="Telos")
    win.set_default_size(420, 180)
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_margin_top(16)
    box.set_margin_bottom(16)
    box.set_margin_start(16)
    box.set_margin_end(16)
    label = Gtk.Label(label="Telos vault password")
    entry = Gtk.Entry()
    entry.set_visibility(False)
    entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
    status = Gtk.Label(label="")
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

    def unlock(*_args):
        password = entry.get_text()
        if not password:
            status.set_text("Empty password")
            return
        proc = subprocess.run(
            ["java", "-jar", JAR, "--unlock-stdin"],
            input=password + "\n",
            text=True,
        )
        if proc.returncode == 0:
            Gtk.main_quit()
            sys.exit(0)
        status.set_text("Unlock failed")

    ok = Gtk.Button(label="Unlock")
    ok.connect("clicked", unlock)
    entry.connect("activate", unlock)
    cancel = Gtk.Button(label="Cancel")
    cancel.connect("clicked", lambda *_: sys.exit(1))
    row.pack_end(ok, False, False, 0)
    row.pack_end(cancel, False, False, 0)
    box.pack_start(label, False, False, 0)
    box.pack_start(entry, False, False, 0)
    box.pack_start(status, False, False, 0)
    box.pack_start(row, False, False, 0)
    win.add(box)
    win.show_all()
    entry.grab_focus()
    Gtk.main()
    sys.exit(1)


if __name__ == "__main__":
    main()
