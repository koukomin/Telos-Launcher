// Telos session niri config. spawn-at-startup is filled by telos-session.
input {
    keyboard {
        xkb { }
    }
}

layout {
    gaps 8
    struts {
        left 0
        right 0
        top 36
        bottom 56
    }
}

binds {
    Mod+Escape { quit; }
    Mod+Shift+E { quit; }
}

hotkey-overlay {
    skip-at-startup
}
