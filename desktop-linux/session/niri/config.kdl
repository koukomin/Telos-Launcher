// Telos session niri config. spawn-at-startup is filled by telos-session.
input {
    keyboard {
        xkb { }
    }
}

layout {
    gaps 8
    struts {
        left 0
        right 0
        top 36
        bottom 56
    }
}

binds {
    Mod+Escape { quit; }
    Mod+Shift+E { quit; }
    // Helix snap approximations (tiling). Compose also handles Super+Arrow.
    Mod+Left { set-window-width "50%"; }
    Mod+Right { set-window-width "50%"; }
    Mod+Up { maximize-column; }
    Mod+Down { set-window-width "50%"; }
    Mod+Ctrl+Left { set-window-width "66%"; }
    Mod+Ctrl+Right { set-window-width "33%"; }
}

hotkey-overlay {
    skip-at-startup
}
