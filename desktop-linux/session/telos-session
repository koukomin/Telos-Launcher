#!/bin/sh
# Telos P0/P1 session: unlock vault as HOME, then run labwc with Telos as the shell.
set -eu

export TELOS_SESSION=1
export TELOS_SESSION_HOME=full
ulimit -c 0 2>/dev/null || true

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  if [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
  else
    export XDG_RUNTIME_DIR="/tmp/telos-runtime-$(id -u)"
    mkdir -p "$XDG_RUNTIME_DIR"
    chmod 700 "$XDG_RUNTIME_DIR"
  fi
fi

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
OPT_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"

JAR="${TELOS_JAR:-}"
if [ -z "$JAR" ]; then
  if [ -f /opt/telos-desktop/telos-desktop.jar ]; then
    JAR=/opt/telos-desktop/telos-desktop.jar
  elif [ -f "$OPT_ROOT/telos-desktop.jar" ]; then
    JAR="$OPT_ROOT/telos-desktop.jar"
  elif ls -1 "$OPT_ROOT"/telos-desktop-linux-*.jar >/dev/null 2>&1; then
    JAR="$(ls -1 "$OPT_ROOT"/telos-desktop-linux-*.jar | head -n 1)"
  else
    JAR="$(ls -1 "$ROOT/desktop-linux/build/compose/jars"/telos-desktop-linux-*.jar 2>/dev/null | head -n 1 || true)"
  fi
fi
if [ -z "$JAR" ] || [ ! -f "$JAR" ]; then
  echo "telos-session: jar not found. Build :desktop-linux:packageUberJarForCurrentOS" >&2
  exit 1
fi
if ! command -v java >/dev/null 2>&1; then
  echo "telos-session: java not on PATH" >&2
  exit 1
fi
if ! command -v labwc >/dev/null 2>&1; then
  echo "telos-session: install labwc (Wayland compositor)" >&2
  exit 1
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && [ "${TELOS_ALLOW_NESTED:-0}" != "1" ]; then
  echo "telos-session: already on Wayland ($WAYLAND_DISPLAY). Set TELOS_ALLOW_NESTED=1 to nest labwc." >&2
  exit 1
fi

LOCKF="$XDG_RUNTIME_DIR/telos-session.lock"
exec 9>"$LOCKF"
if command -v flock >/dev/null 2>&1; then
  if ! flock -n 9; then
    echo "telos-session: already running" >&2
    exit 1
  fi
fi

export TELOS_JAR="$JAR"

CONF="$XDG_RUNTIME_DIR/telos-labwc"
mkdir -p "$CONF"
chmod 700 "$CONF" 2>/dev/null || true
cp -f "$SCRIPT_DIR/labwc/rc.xml" "$CONF/rc.xml"
cp -f "$SCRIPT_DIR/labwc/menu.xml" "$CONF/menu.xml"
cp -f "$SCRIPT_DIR/labwc/autostart" "$CONF/autostart"
chmod +x "$CONF/autostart"
cp -f "$SCRIPT_DIR/labwc/environment" "$CONF/environment"

if [ "${TELOS_VAULT_UNLOCKED:-0}" != "1" ]; then
  java -jar "$JAR" --unlock-only
  ENVF="$XDG_RUNTIME_DIR/telos-session.env"
  if [ -f "$ENVF" ]; then
    # shellcheck disable=SC1090
    . "$ENVF"
    rm -f "$ENVF"
  fi
fi

if [ "${TELOS_VAULT_UNLOCKED:-0}" != "1" ] || [ -z "${TELOS_HOST_HOME:-}" ]; then
  echo "telos-session: vault unlock did not export TELOS_HOST_HOME" >&2
  exit 1
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
  eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

swapoff -a 2>/dev/null || true

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Telos:labwc}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Telos}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
export _JAVA_AWT_WM_NONREPARENTING=1

CLEANED=0
cleanup() {
  if [ "$CLEANED" = 1 ]; then
    return 0
  fi
  CLEANED=1
  java -jar "$JAR" --lock-only >/dev/null 2>&1 || true
  nft delete table inet telos_session 2>/dev/null || \
    pkexec nft delete table inet telos_session 2>/dev/null || true
}
trap cleanup EXIT INT TERM

labwc -C "$CONF"
